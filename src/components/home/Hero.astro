---
import "../../styles/hero.css";
import { withBase } from "../../lib/paths";

const backgroundImage = `url("${withBase("images/hero-background.webp")}")`;
---

<section id="inicio" class="hero" style={`--hero-img: ${backgroundImage}`}>
  <h1>
    <slot name="title" />
  </h1>
  <p>
    <slot name="description" />
  </p>
  <div>
    <slot name="actions" />
  </div>
</section>
