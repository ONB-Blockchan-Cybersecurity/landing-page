---
import "../../styles/auth.css";

interface Props {
  subtitle: string;
  title: string;
  titleHighlight?: string;
  description: string;
  features?: string[];
}

const { subtitle, title, titleHighlight, description, features = [] } =
  Astro.props;
---

<section class="auth-container">
  <div class="auth-card">
    <div class="auth-info">
      <span class="auth-subtitle">{subtitle}</span>
      <h1 class="auth-title">
        {title}
        {titleHighlight && <span>{titleHighlight}</span>}
      </h1>
      <p class="auth-description">{description}</p>
      {
        features.length > 0 && (
          <ul class="auth-features">
            {features.map((feature) => (
              <li>{feature}</li>
            ))}
          </ul>
        )
      }
    </div>
    <div class="auth-form-wrapper">
      <slot />
    </div>
  </div>
</section>
